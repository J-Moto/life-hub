// Life Hub Worker config. Committed to a PUBLIC repo: no secrets and no personal IDs here.
// Secrets (set with `npx wrangler secret put NAME`): TOKEN_ENC_KEY, ACCESS_AUD, ALLOWED_EMAIL,
//   TICKTICK_CLIENT_ID, TICKTICK_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
// Local dev values go in .dev.vars (gitignored, and Claude is blocked from reading it).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request hits the Worker first, so the Access check covers the page too.
    "run_worker_first": true
  },
  "kv_namespaces": [{ "binding": "TOKENS" }],
  "triggers": { "crons": ["7 * * * *"] },
  "vars": {
    "TIME_ZONE": "America/Indiana/Indianapolis",
    "ACCESS_TEAM_DOMAIN": "",
    "USE_FAKES": "false"
  },
  // Keep vars set in the Cloudflare dashboard (personal IDs) instead of wiping them on each deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
