{
  "sandbox": {
    "enabled": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./secrets/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.wrangler/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git -C:*)",
      "Bash(npx:*)",
      "Bash(wrangler:*)",
      "Bash(./node_modules/.bin/wrangler:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm exec:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run dev)"
    ]
  }
}
